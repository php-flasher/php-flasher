#!/usr/bin/env zsh
# -----------------------------------------------------------------------------
# assets v1.0.0
#
# Description:
#   Build PHP-Flasher front-end assets via Rollup.
#   Supports watch mode, size analysis, and deep file inspection.
#
# Usage:
#   assets [options]
#
# Examples:
#   assets                       # Production build
#   assets -w                    # Watch mode (development)
#   assets -d                    # Development build (unminified)
#   assets -a                    # Show size analysis
#   assets -D                    # Deep analysis with checksums
#   assets --dry-run             # Preview what would run
# -----------------------------------------------------------------------------
VERSION="1.0.0"
source "${0:A:h}/_lib.zsh"

# --- Configuration ---
SRC_DIR="src"
PRIME_PATH="${SRC_DIR}/Prime/Resources"
TEMP_DIR="/tmp/php-flasher-build-$$"
BUILD_LOG="${TEMP_DIR}/build.log"

VERBOSE=0
WATCH_MODE=0
THEME_ONLY=0
MODULE_ONLY=0
ANALYZE=0
DEEP_ANALYZE=0
SKIP_CLEAR=0
NODE_ENV="production"

# --- Cleanup ---
script_cleanup() {
    rm -rf "${TEMP_DIR}" 2>/dev/null
}

mkdir -p "${TEMP_DIR}"

# --- Usage ---
usage() {
    cat <<EOF
${COLOR_BOLD}${COLOR_GREEN}Usage:${COLOR_RESET} ${SCRIPT_NAME} [options]

${COLOR_BOLD}${COLOR_GREEN}Description:${COLOR_RESET}
  Build PHP-Flasher front-end assets via Rollup.

${COLOR_BOLD}${COLOR_YELLOW}Options:${COLOR_RESET}
  ${COLOR_CYAN}--verbose${COLOR_RESET}           Show full build output (quiet by default)
  ${COLOR_CYAN}-w, --watch${COLOR_RESET}         Run in watch mode (implies development)
  ${COLOR_CYAN}--development${COLOR_RESET}       Build in development mode (unminified)
  ${COLOR_CYAN}-t, --themes-only${COLOR_RESET}   Build only themes
  ${COLOR_CYAN}-m, --modules-only${COLOR_RESET}  Build only modules (core and plugins)
  ${COLOR_CYAN}-a, --analyze${COLOR_RESET}       Show size analysis table
  ${COLOR_CYAN}-D, --deep-analyze${COLOR_RESET}  Deep analysis (checksums, content inspection)
  ${COLOR_CYAN}--skip-clear${COLOR_RESET}        Skip clearing output directories
  ${COLOR_CYAN}-n, --dry-run${COLOR_RESET}       Show what would run without executing
  ${COLOR_CYAN}-q, --quiet${COLOR_RESET}         Suppress all output
  ${COLOR_CYAN}-d, --debug${COLOR_RESET}         Enable debug logging
  ${COLOR_CYAN}-v, --version${COLOR_RESET}       Display version
  ${COLOR_CYAN}-h, --help${COLOR_RESET}          Display this help message

${COLOR_BOLD}${COLOR_BLUE}Examples:${COLOR_RESET}
  ${SCRIPT_NAME}                       # Production build
  ${SCRIPT_NAME} -w                    # Watch mode
  ${SCRIPT_NAME} --development         # Development build
  ${SCRIPT_NAME} -a                    # Show size analysis
  ${SCRIPT_NAME} -D                    # Deep analysis with checksums
EOF
}

# --- Argument Parsing ---
parse_arguments() {
    while [[ $# -gt 0 ]]; do
        if parse_common_flag "$1"; then
            shift
            continue
        fi
        case "$1" in
            --verbose)        VERBOSE=1; shift ;;
            -w|--watch)       WATCH_MODE=1; NODE_ENV="development"; shift ;;
            --development)    NODE_ENV="development"; shift ;;
            -t|--themes-only) THEME_ONLY=1; shift ;;
            -m|--modules-only) MODULE_ONLY=1; shift ;;
            -a|--analyze)     ANALYZE=1; shift ;;
            -D|--deep-analyze) ANALYZE=1; DEEP_ANALYZE=1; shift ;;
            --skip-clear)     SKIP_CLEAR=1; shift ;;
            *)
                error_log "Unknown option: $1"
                usage
                exit 1 ;;
        esac
    done

    if [[ "$THEME_ONLY" -eq 1 && "$MODULE_ONLY" -eq 1 ]]; then
        error_log "Cannot specify both --themes-only and --modules-only"
        exit 1
    fi

    if [[ "$ANALYZE" -eq 1 ]]; then
        export FILESIZE_SILENT=true
    fi
}

# --- Build ---
run_build() {
    info_log "── 🏗️  ${COLOR_BOLD}Build${COLOR_RESET} ──"
    echo ""

    export NODE_ENV="$NODE_ENV"
    export ANALYZE="$ANALYZE"
    export DEEP_ANALYZE="$DEEP_ANALYZE"

    local rollup_args="-c"
    [[ "$WATCH_MODE" -eq 1 ]] && rollup_args="-c -w"

    if [[ "$THEME_ONLY" -eq 1 ]]; then
        info_log "Scope: themes only"
    elif [[ "$MODULE_ONLY" -eq 1 ]]; then
        info_log "Scope: modules only"
    fi

    if [[ "$VERBOSE" -eq 1 ]]; then
        run_cmd npx rollup $rollup_args || return 1
    else
        if [[ "$DRY_RUN" -eq 1 ]]; then
            run_cmd npx rollup $rollup_args
        else
            printf "  ${COLOR_BLUE}❯${COLOR_RESET} ${COLOR_DIM}npx rollup %s${COLOR_RESET}\n" "$rollup_args"
            if npx rollup $rollup_args > "$BUILD_LOG" 2>&1; then
                ok_log "Build completed"
            else
                error_log "Build failed"
                [[ "$QUIET" -eq 0 ]] && cat "$BUILD_LOG"
                return 1
            fi
        fi
    fi
}

# --- Size Analysis ---
get_size_info() {
    local file="$1"
    local bytes=$(wc -c < "$file")
    local size=$(du -h "$file" | awk '{print $1}')
    local gzip_size=$(gzip -c "$file" | wc -c | numfmt --to=iec --format="%.1f")
    local brotli_size=$(brotli -c "$file" 2>/dev/null | wc -c | numfmt --to=iec --format="%.1f" || echo "N/A")
    echo "$size|$gzip_size|$bytes|$brotli_size"
}

get_file_hash() {
    local file="$1"
    if command -v sha256sum &>/dev/null; then
        sha256sum "$file" | awk '{print $1}'
    elif command -v shasum &>/dev/null; then
        shasum -a 256 "$file" | awk '{print $1}'
    else
        echo "HASH_UNAVAILABLE"
    fi
}

analyze_file_content() {
    local file="$1"
    local filename="${file:t}"
    local dir="${TEMP_DIR}/analysis/$(echo "${file:h}" | sed 's/\//_/g')"
    mkdir -p "$dir"

    head -n 10 "$file" > "${dir}/${filename}.head"

    local hash=$(get_file_hash "$file")
    echo "$hash" > "${dir}/${filename}.hash"

    if [[ "$file" == *.css || "$file" == *.js ]]; then
        local semicolons=$(grep -o ";" "$file" | wc -l)
        local newlines=$(grep -c $'\n' "$file")

        if [[ "$newlines" -lt 10 ]] || [[ "$semicolons" -gt "$((newlines * 5))" ]]; then
            echo "MINIFIED:YES semicolons:$semicolons newlines:$newlines" > "${dir}/${filename}.analysis"
        else
            echo "MINIFIED:NO semicolons:$semicolons newlines:$newlines" > "${dir}/${filename}.analysis"
        fi
    fi

    echo "$hash"
}

collect_build_statistics() {
    local modules_count=0
    local themes_count=0
    local theme_names=()
    local unique_css_hashes=0
    local unique_js_hashes=0
    typeset -A css_hashes js_hashes

    mkdir -p "${TEMP_DIR}/modules" "${TEMP_DIR}/themes" "${TEMP_DIR}/analysis"

    debug_log "Collecting build statistics..."

    # Core flasher module
    if [[ -f "${PRIME_PATH}/dist/flasher.min.js" ]]; then
        local size_info=$(get_size_info "${PRIME_PATH}/dist/flasher.min.js")
        local hash="N/A"
        if [[ "$DEEP_ANALYZE" -eq 1 ]]; then
            hash=$(analyze_file_content "${PRIME_PATH}/dist/flasher.min.js")
            js_hashes["$hash"]=1
            unique_js_hashes=$((unique_js_hashes + 1))
        fi
        echo "flasher:$size_info:$hash" >> "${TEMP_DIR}/modules/data"
        modules_count=$((modules_count + 1))
    fi

    # Plugin modules
    find ${SRC_DIR}/*/Prime/Resources/dist -name "*.min.js" 2>/dev/null | grep -v themes > "${TEMP_DIR}/module_files.txt" 2>/dev/null || true

    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        local module="${file:t:r:r}"  # strip .min.js
        local size_info=$(get_size_info "$file")
        local hash="N/A"
        if [[ "$DEEP_ANALYZE" -eq 1 ]]; then
            hash=$(analyze_file_content "$file")
            js_hashes["$hash"]=1
            unique_js_hashes=$((unique_js_hashes + 1))
        fi
        echo "$module:$size_info:$hash" >> "${TEMP_DIR}/modules/data"
        modules_count=$((modules_count + 1))
        debug_log "Module: $module ($size_info)"
    done < "${TEMP_DIR}/module_files.txt"

    # Theme statistics
    if [[ -d "${PRIME_PATH}/dist/themes" ]]; then
        find ${PRIME_PATH}/dist/themes -name "*.min.js" 2>/dev/null > "${TEMP_DIR}/theme_files.txt" 2>/dev/null || true

        while IFS= read -r file; do
            [[ -z "$file" ]] && continue
            local theme="${file:h:t}"
            local size_info=$(get_size_info "$file")
            local js_hash="N/A"
            local css_hash="N/A"
            local css_size_info="N/A"

            local css_file="${PRIME_PATH}/dist/themes/${theme}/${theme}.min.css"
            if [[ -f "$css_file" ]]; then
                css_size_info=$(get_size_info "$css_file")

                if [[ "$DEEP_ANALYZE" -eq 1 ]]; then
                    css_hash=$(analyze_file_content "$css_file")
                    if [[ -z "${css_hashes[$css_hash]:-}" ]]; then
                        css_hashes["$css_hash"]=1
                        unique_css_hashes=$((unique_css_hashes + 1))
                    else
                        css_hashes["$css_hash"]=$((css_hashes["$css_hash"] + 1))
                    fi

                    js_hash=$(analyze_file_content "$file")
                    if [[ -z "${js_hashes[$js_hash]:-}" ]]; then
                        js_hashes["$js_hash"]=1
                    else
                        js_hashes["$js_hash"]=$((js_hashes["$js_hash"] + 1))
                    fi
                fi

                debug_log "Theme $theme JS: $size_info, CSS: $css_size_info"
            fi

            echo "$theme:$size_info:$js_hash:$css_size_info:$css_hash" >> "${TEMP_DIR}/themes/data"
            theme_names+=("$theme")
            themes_count=$((themes_count + 1))
        done < "${TEMP_DIR}/theme_files.txt"

        if [[ ${#theme_names[@]} -gt 0 ]]; then
            printf "%s\n" "${theme_names[@]}" | sort > "${TEMP_DIR}/theme_names"
        fi
    fi

    echo "$modules_count" > "${TEMP_DIR}/modules_count"
    echo "$themes_count" > "${TEMP_DIR}/themes_count"
    echo "$unique_js_hashes" > "${TEMP_DIR}/unique_js_hashes"
    echo "$unique_css_hashes" > "${TEMP_DIR}/unique_css_hashes"

    if [[ "$DEEP_ANALYZE" -eq 1 ]]; then
        echo "JS Hash Distribution:" > "${TEMP_DIR}/hash_stats.txt"
        for hash in "${(@k)js_hashes}"; do
            echo "  $hash: ${js_hashes[$hash]} files" >> "${TEMP_DIR}/hash_stats.txt"
        done
        echo "\nCSS Hash Distribution:" >> "${TEMP_DIR}/hash_stats.txt"
        for hash in "${(@k)css_hashes}"; do
            echo "  $hash: ${css_hashes[$hash]} files" >> "${TEMP_DIR}/hash_stats.txt"
        done
    fi
}

# --- Reporting ---
print_size_table() {
    local title="$1"
    local data_file="$2"
    local max_name_len=20

    [[ ! -f "$data_file" || ! -s "$data_file" ]] && return

    echo ""
    printf "  ${COLOR_BOLD}%s${COLOR_RESET}\n\n" "$title"

    if [[ "$DEEP_ANALYZE" -eq 1 ]]; then
        printf "  ${COLOR_BOLD}%-${max_name_len}s %-10s %-10s %-10s %-10s${COLOR_RESET}\n" "Component" "Size" "Gzip" "Bytes" "Hash"
    else
        printf "  ${COLOR_BOLD}%-${max_name_len}s %-10s %-10s %-10s${COLOR_RESET}\n" "Component" "Size" "Gzip" "Bytes"
    fi
    printf "  ${COLOR_DIM}%s${COLOR_RESET}\n" "$(printf '%.0s─' {1..65})"

    while IFS=: read -r line; do
        local fields=()
        IFS=: read -rA fields <<< "$line"

        local name="${fields[1]}"
        local size_data="${fields[2]}"
        local hash="${fields[3]:-N/A}"

        IFS='|' read -r size gzip bytes brotli <<< "$size_data"

        if [[ "$DEEP_ANALYZE" -eq 1 ]]; then
            printf "  %-${max_name_len}s ${COLOR_GREEN}%-10s${COLOR_RESET} ${COLOR_BLUE}%-10s${COLOR_RESET} ${COLOR_YELLOW}%-10s${COLOR_RESET} ${COLOR_DIM}%.8s${COLOR_RESET}\n" \
                "$name" "$size" "$gzip" "$bytes" "$hash"
        else
            printf "  %-${max_name_len}s ${COLOR_GREEN}%-10s${COLOR_RESET} ${COLOR_BLUE}%-10s${COLOR_RESET} ${COLOR_YELLOW}%-10s${COLOR_RESET}\n" \
                "$name" "$size" "$gzip" "$bytes"
        fi
    done < "$data_file"
}

print_theme_table() {
    local data_file="$1"
    local max_name_len=15

    [[ ! -f "$data_file" || ! -s "$data_file" ]] && return

    echo ""
    printf "  ${COLOR_BOLD}Theme Sizes${COLOR_RESET}\n\n"
    printf "  ${COLOR_BOLD}%-${max_name_len}s %-10s %-10s %-10s %-10s${COLOR_RESET}\n" "Theme" "JS Size" "CSS Size" "JS Bytes" "CSS Bytes"
    printf "  ${COLOR_DIM}%s${COLOR_RESET}\n" "$(printf '%.0s─' {1..65})"

    while IFS=: read -r line; do
        local fields=()
        IFS=: read -rA fields <<< "$line"

        local name="${fields[1]}"
        local js_size_data="${fields[2]}"
        local css_size_data="${fields[4]:-N/A}"

        IFS='|' read -r js_size js_gzip js_bytes js_brotli <<< "$js_size_data"

        local css_size="N/A" css_bytes="N/A"
        if [[ "$css_size_data" != "N/A" ]]; then
            IFS='|' read -r css_size css_gzip css_bytes css_brotli <<< "$css_size_data"
        fi

        printf "  %-${max_name_len}s ${COLOR_GREEN}%-10s${COLOR_RESET} ${COLOR_MAGENTA}%-10s${COLOR_RESET} ${COLOR_YELLOW}%-10s${COLOR_RESET} ${COLOR_BLUE}%-10s${COLOR_RESET}\n" \
            "$name" "$js_size" "$css_size" "$js_bytes" "$css_bytes"
    done < "$data_file"
}

print_theme_grid() {
    local theme_names_file="$1"
    [[ ! -f "$theme_names_file" || ! -s "$theme_names_file" ]] && return

    echo ""
    printf "  ${COLOR_BOLD}${COLOR_MAGENTA}🎨 Themes:${COLOR_RESET}\n"

    local columns=3
    local max_width=15
    local count=0

    while read -r theme; do
        if [[ $((count % columns)) -eq 0 ]]; then
            printf "    "
        fi
        printf "• %-${max_width}s" "$theme"
        count=$((count + 1))
        if [[ $((count % columns)) -eq 0 ]]; then
            echo ""
        fi
    done < "$theme_names_file"

    [[ $((count % columns)) -ne 0 ]] && echo ""
}

print_deep_analysis() {
    [[ ! -d "${TEMP_DIR}/analysis" ]] && return

    local unique_js=0 unique_css=0
    [[ -f "${TEMP_DIR}/unique_js_hashes" ]] && unique_js=$(cat "${TEMP_DIR}/unique_js_hashes")
    [[ -f "${TEMP_DIR}/unique_css_hashes" ]] && unique_css=$(cat "${TEMP_DIR}/unique_css_hashes")

    echo ""
    printf "  ${COLOR_BOLD}Deep File Analysis${COLOR_RESET}\n"
    printf "  ${COLOR_DIM}%s${COLOR_RESET}\n" "$(printf '%.0s─' {1..50})"
    printf "  Unique JavaScript files: ${COLOR_YELLOW}${unique_js}${COLOR_RESET}\n"
    printf "  Unique CSS files: ${COLOR_MAGENTA}${unique_css}${COLOR_RESET}\n"

    if [[ -f "${TEMP_DIR}/hash_stats.txt" ]]; then
        echo ""
        printf "  ${COLOR_BOLD}Hash Distribution:${COLOR_RESET}\n"
        head -n 10 "${TEMP_DIR}/hash_stats.txt" | sed 's/^/  /'
    fi
}

# --- Summary ---
print_summary() {
    local build_success=$1
    local duration=$2

    local modules_count=0 themes_count=0
    [[ -f "${TEMP_DIR}/modules_count" ]] && modules_count=$(cat "${TEMP_DIR}/modules_count")
    [[ -f "${TEMP_DIR}/themes_count" ]] && themes_count=$(cat "${TEMP_DIR}/themes_count")

    echo ""
    echo ""
    info_log "── ${COLOR_BOLD}Summary${COLOR_RESET} ──"
    echo ""

    if [[ "$build_success" == "true" ]]; then
        printf "  ${COLOR_GREEN}✓${COLOR_RESET} Build completed in ${COLOR_BOLD}${COLOR_YELLOW}${duration}s${COLOR_RESET}\n"
    else
        printf "  ${COLOR_RED}✗${COLOR_RESET} Build failed after ${COLOR_BOLD}${COLOR_YELLOW}${duration}s${COLOR_RESET}\n"
    fi

    [[ "$MODULE_ONLY" -eq 0 ]] && printf "  ${COLOR_GREEN}✓${COLOR_RESET} Modules/Plugins: ${COLOR_BOLD}${COLOR_CYAN}${modules_count}${COLOR_RESET}\n"
    [[ "$THEME_ONLY" -eq 0 ]] && printf "  ${COLOR_GREEN}✓${COLOR_RESET} Themes: ${COLOR_BOLD}${COLOR_MAGENTA}${themes_count}${COLOR_RESET}\n"

    [[ -f "${TEMP_DIR}/theme_names" ]] && print_theme_grid "${TEMP_DIR}/theme_names"

    if [[ "$ANALYZE" -eq 1 ]]; then
        echo ""
        info_log "── 📊 ${COLOR_BOLD}Size Analysis${COLOR_RESET} ──"
        print_size_table "Module Sizes" "${TEMP_DIR}/modules/data"

        if [[ "$DEEP_ANALYZE" -eq 1 ]]; then
            print_theme_table "${TEMP_DIR}/themes/data"
            print_deep_analysis
        else
            print_size_table "Theme Sizes" "${TEMP_DIR}/themes/data"
        fi
    fi

    echo ""
}

# --- Main ---
main() {
    parse_arguments "$@"

    local start=$SECONDS
    local build_success=true

    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "${COLOR_BOLD}${COLOR_YELLOW}🏗️  Assets${COLOR_RESET} ${COLOR_DIM}build PHP-Flasher assets...${COLOR_RESET} ${COLOR_YELLOW}[DRY-RUN]${COLOR_RESET}"
    else
        echo "${COLOR_BOLD}${COLOR_CYAN}🏗️  Assets${COLOR_RESET} ${COLOR_DIM}build PHP-Flasher assets...${COLOR_RESET}"
    fi

    if [[ "$NODE_ENV" != "production" ]]; then
        info_log "Mode: ${COLOR_YELLOW}${NODE_ENV}${COLOR_RESET}"
    fi
    [[ "$WATCH_MODE" -eq 1 ]] && info_log "Watch: ${COLOR_CYAN}enabled${COLOR_RESET}"

    echo ""
    run_build || build_success=false

    # Collect statistics if build succeeded and not in watch mode
    if [[ "$WATCH_MODE" -eq 0 && "$build_success" == "true" ]]; then
        if [[ "$ANALYZE" -eq 1 ]]; then
            echo ""
            info_log "── 📊 ${COLOR_BOLD}Analyzing Output${COLOR_RESET} ──"
        fi
        collect_build_statistics
    fi

    if [[ "$WATCH_MODE" -eq 0 ]]; then
        local duration=$(( SECONDS - start ))
        print_summary "$build_success" "$duration"
    fi

    [[ "$build_success" == "true" ]] && exit 0 || exit 1
}

main "$@"
