#!/usr/bin/env zsh
# -----------------------------------------------------------------------------
# status v1.0.0
#
# Description:
#   Display PHP-Flasher repository status dashboard.
#   Shows git status, dependencies, repo info, and release readiness.
#
# Usage:
#   status [options]
#
# Examples:
#   status                       # Full status dashboard
#   status -q                    # Quiet mode (summary only)
#   status --debug               # Show debug info
# -----------------------------------------------------------------------------
VERSION="1.0.0"
source "${0:A:h}/_lib.zsh"

# Disable errexit for this script — many API calls can fail
set +e

ORGANIZATION="php-flasher"
MAIN_BRANCH="2.x"

ALL_REPOS=(
    flasher
    flasher-laravel
    flasher-symfony
    flasher-noty
    flasher-noty-laravel
    flasher-noty-symfony
    flasher-notyf
    flasher-notyf-laravel
    flasher-notyf-symfony
    flasher-sweetalert
    flasher-sweetalert-laravel
    flasher-sweetalert-symfony
    flasher-toastr
    flasher-toastr-laravel
    flasher-toastr-symfony
)

# --- Usage ---
usage() {
    cat <<EOF
${COLOR_BOLD}${COLOR_GREEN}Usage:${COLOR_RESET} ${SCRIPT_NAME} [options]

${COLOR_BOLD}${COLOR_GREEN}Description:${COLOR_RESET}
  Display PHP-Flasher repository status dashboard.

${COLOR_BOLD}${COLOR_YELLOW}Options:${COLOR_RESET}
  ${COLOR_CYAN}-q, --quiet${COLOR_RESET}         Summary only
  ${COLOR_CYAN}-d, --debug${COLOR_RESET}         Enable debug logging
  ${COLOR_CYAN}-v, --version${COLOR_RESET}       Display version
  ${COLOR_CYAN}-h, --help${COLOR_RESET}          Display this help message

${COLOR_BOLD}${COLOR_BLUE}Examples:${COLOR_RESET}
  ${SCRIPT_NAME}                       # Full status dashboard
  ${SCRIPT_NAME} --debug               # Show debug info
EOF
}

# --- Argument Parsing ---
while [[ $# -gt 0 ]]; do
    if parse_common_flag "$1"; then
        shift
    else
        error_log "Unknown option: $1"
        usage
        exit 1
    fi
done

# --- API Helpers ---
curl_cmd() {
    local gh_token=${GITHUB_TOKEN:-""}
    local auth_header=""
    [[ -n "$gh_token" ]] && auth_header="-H" && auth_header2="Authorization: token $gh_token"

    if [[ -n "$gh_token" ]]; then
        curl -s -H "User-Agent: PHP-Flasher-Status" -H "Authorization: token $gh_token" "$@"
    else
        curl -s -H "User-Agent: PHP-Flasher-Status" "$@"
    fi
}

get_latest_tag() {
    git ls-remote --tags --refs "git@github.com:${ORGANIZATION}/$1.git" 2>/dev/null |
        sort -t '/' -k 3 -V | tail -n1 | awk -F/ '{print $3}'
}

get_repo_stats() {
    local repo=$1
    local tmp_dir="/tmp/php-flasher-status/${repo}"

    mkdir -p "$tmp_dir"
    if [[ ! -d "$tmp_dir/.git" ]]; then
        git clone -q "git@github.com:${ORGANIZATION}/${repo}.git" "$tmp_dir" 2>/dev/null || return 1
    fi

    (
        cd "$tmp_dir"
        git fetch -q origin 2>/dev/null
        echo "$(git rev-parse --short HEAD)|$(git rev-parse --abbrev-ref HEAD)|$(git log -1 --format='%cr')|$(git log -1 --format='%s')"
    )
}

get_github_stars() {
    local response=$(curl_cmd "https://api.github.com/repos/${ORGANIZATION}/$1")
    echo "$response" | grep -o '"stargazers_count":[0-9]*' | cut -d':' -f2
}

get_packagist_version() {
    local response=$(curl -s -f "https://repo.packagist.org/p2/php-flasher/$1.json" 2>/dev/null)
    if [[ $? -eq 0 && -n "$response" ]]; then
        local version=$(echo "$response" | grep -o '"latest":"[^"]*"' | cut -d'"' -f4)
        echo "${version:-N/A}"
    else
        echo "N/A"
    fi
}

get_npm_version() {
    local package=$1
    if [[ "$package" == *"-laravel" || "$package" == *"-symfony" ]]; then
        echo "N/A"
        return
    fi
    local response=$(curl_cmd "https://registry.npmjs.org/@flasher/${package}/latest" 2>/dev/null)
    local version=$(echo "$response" | grep -o '"version":"[^"]*"' | cut -d'"' -f4)
    echo "${version:-N/A}"
}

# --- Dashboard Sections ---
check_git_status() {
    echo ""
    info_log "── 🌿 ${COLOR_BOLD}Git Status${COLOR_RESET} ──"
    echo ""

    local current_branch=$(git rev-parse --abbrev-ref HEAD)
    printf "  Branch: ${COLOR_BOLD}%s${COLOR_RESET}" "$current_branch"
    if [[ "$current_branch" != "$MAIN_BRANCH" ]]; then
        printf " ${COLOR_YELLOW}(not on $MAIN_BRANCH)${COLOR_RESET}"
    fi
    echo ""

    if [[ -n "$(git status --porcelain)" ]]; then
        warn_log "Working directory is not clean"
        git status --short | sed 's/^/    /'
    else
        ok_log "Working directory is clean"
    fi

    local behind=$(git rev-list "HEAD..origin/$current_branch" --count 2>/dev/null || echo "0")
    local ahead=$(git rev-list "origin/$current_branch..HEAD" --count 2>/dev/null || echo "0")

    if [[ "$behind" -gt 0 ]]; then warn_log "Branch is behind by $behind commit(s)"; fi
    if [[ "$ahead" -gt 0 ]]; then warn_log "Branch is ahead by $ahead commit(s)"; fi
    if [[ "$behind" -eq 0 && "$ahead" -eq 0 ]]; then ok_log "Branch is up to date with origin"; fi
}

check_dependencies() {
    echo ""
    info_log "── 📦 ${COLOR_BOLD}Dependencies${COLOR_RESET} ──"
    echo ""

    if [[ -f "composer.json" ]]; then
        printf "  ${COLOR_BOLD}Composer:${COLOR_RESET}\n"
        composer show 2>/dev/null | grep "php-flasher/" | sed 's/^/    /' || echo "    No PHP-Flasher dependencies"
    fi

    if [[ -f "package.json" ]]; then
        echo ""
        printf "  ${COLOR_BOLD}NPM:${COLOR_RESET}\n"
        command npm list 2>/dev/null | grep "@flasher/" | sed 's/^/    /' || echo "    No Flasher dependencies"
    fi
}

display_modified_files() {
    echo ""
    info_log "── 📝 ${COLOR_BOLD}Modified Files${COLOR_RESET} ──"
    echo ""

    local modified=$(git diff --name-only 2>/dev/null)
    if [[ -n "$modified" ]]; then
        echo "$modified" | sed 's/^/    /'
    else
        ok_log "No modified files"
    fi
}

display_repo_info() {
    local repo=$1
    local latest_tag=$(get_latest_tag "$repo")
    local stats=$(get_repo_stats "$repo")
    local github_stars=$(get_github_stars "$repo")
    local packagist_version=$(get_packagist_version "$repo")

    local sha branch time_ago message
    IFS='|' read -r sha branch time_ago message <<< "$stats"

    echo ""
    printf "  ${COLOR_BOLD}${COLOR_MAGENTA}📦 %s${COLOR_RESET}\n" "$repo"
    printf "    🌿 Branch    : %s\n" "${branch:-unknown}"
    printf "    🏷️  Tag       : %s\n" "${latest_tag:-none}"
    printf "    ⭐ Stars     : %s\n" "${github_stars:-0}"
    printf "    🎯 Packagist : v%s\n" "$packagist_version"

    # NPM version for applicable packages
    if [[ "$repo" == "flasher" || "$repo" == flasher-noty || "$repo" == flasher-notyf || \
          "$repo" == flasher-sweetalert || "$repo" == flasher-toastr ]]; then
        local npm_ver=$(get_npm_version "$repo")
        [[ "$npm_ver" != "N/A" ]] && printf "    📦 NPM       : v%s\n" "$npm_ver"
    fi

    printf "    ⭐ Commit    : %s (%s)\n" "${sha:-unknown}" "${time_ago:-unknown}"
    printf "    ℹ️  Message   : %s\n" "${message:-unknown}"
}

check_release_readiness() {
    echo ""
    info_log "── 🚀 ${COLOR_BOLD}Release Readiness${COLOR_RESET} ──"
    echo ""

    local ready=true

    if [[ -n "$(git status --porcelain)" ]]; then
        warn_log "Working directory is not clean"
        ready=false
    fi

    if [[ "$(git rev-parse --abbrev-ref HEAD)" != "$MAIN_BRANCH" ]]; then
        warn_log "Not on main branch ($MAIN_BRANCH)"
        ready=false
    fi

    if $ready; then
        ok_log "Ready for release!"
        echo ""
        printf "  ${COLOR_BOLD}Suggested next steps:${COLOR_RESET}\n"
        printf "    1. ${COLOR_DIM}./bin/split${COLOR_RESET}\n"
        printf "    2. ${COLOR_DIM}./bin/release <version>${COLOR_RESET}\n"
    else
        warn_log "Not ready for release. Fix the issues above."
    fi
}

# --- Main ---
main() {
    echo "${COLOR_BOLD}${COLOR_CYAN}📊 Status${COLOR_RESET} ${COLOR_DIM}PHP-Flasher repository dashboard...${COLOR_RESET}"

    check_git_status
    check_dependencies
    display_modified_files

    echo ""
    info_log "── 📦 ${COLOR_BOLD}Repositories${COLOR_RESET} ──"

    for repo in $ALL_REPOS; do
        display_repo_info "$repo"
    done

    check_release_readiness
    echo ""
}

main
