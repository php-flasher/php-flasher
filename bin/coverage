#!/usr/bin/env zsh
# -----------------------------------------------------------------------------
# coverage v1.0.0
#
# Description:
#   Run PHP-Flasher test suites with coverage reporting.
#
# Usage:
#   coverage [options]
#
# Examples:
#   coverage                     # Run all coverage modules
#   coverage --no-vitest         # Skip Vitest
#   coverage --open              # Open reports after running
#   coverage --dry-run           # Preview what would run
# -----------------------------------------------------------------------------
VERSION="1.0.0"
source "${0:A:h}/_lib.zsh"

PHP_BINARY="${PHP_BINARY:-/opt/homebrew/opt/php@8.2/bin/php}"
OPEN_REPORTS=0

# --- Module Configuration ---
ALL_MODULES=(cleanup phpunit vitest)

typeset -A MODULE_NAME MODULE_ICON MODULE_ACTIVE
MODULE_NAME=(
    cleanup "Cleanup Reports"
    phpunit "PHPUnit Coverage"
    vitest  "Vitest Coverage"
)
MODULE_ICON=(
    cleanup "🧹"
    phpunit "🧪"
    vitest  "🧪"
)

for mod in $ALL_MODULES; do MODULE_ACTIVE[$mod]=1; done

typeset -A RESULT_STATUS RESULT_DURATION
ENABLED_MODULES=()
TOTAL_START=0

# --- Usage ---
usage() {
    cat <<EOF
${COLOR_BOLD}${COLOR_GREEN}Usage:${COLOR_RESET} ${SCRIPT_NAME} [options]

${COLOR_BOLD}${COLOR_GREEN}Description:${COLOR_RESET}
  Run PHP-Flasher test suites with coverage reporting.

${COLOR_BOLD}${COLOR_YELLOW}Modules:${COLOR_RESET} (use --no-MODULE to skip)
  ${COLOR_CYAN}cleanup${COLOR_RESET}             Clean up old coverage reports
  ${COLOR_CYAN}phpunit${COLOR_RESET}             PHPUnit with HTML/text coverage
  ${COLOR_CYAN}vitest${COLOR_RESET}              Vitest with HTML/JSON coverage

${COLOR_BOLD}${COLOR_YELLOW}Options:${COLOR_RESET}
  ${COLOR_CYAN}-o, --open${COLOR_RESET}          Open HTML reports after running
  ${COLOR_CYAN}--php-binary PATH${COLOR_RESET}   Path to PHP binary (default: php@8.2)
  ${COLOR_CYAN}-n, --dry-run${COLOR_RESET}       Show what would run without executing
  ${COLOR_CYAN}-q, --quiet${COLOR_RESET}         Suppress command output
  ${COLOR_CYAN}-d, --debug${COLOR_RESET}         Enable debug logging
  ${COLOR_CYAN}-v, --version${COLOR_RESET}       Display version
  ${COLOR_CYAN}-h, --help${COLOR_RESET}          Display this help message

${COLOR_BOLD}${COLOR_BLUE}Examples:${COLOR_RESET}
  ${SCRIPT_NAME}                     # Run all coverage modules
  ${SCRIPT_NAME} --no-vitest         # Skip Vitest
  ${SCRIPT_NAME} --open              # Open reports after running
  ${SCRIPT_NAME} --dry-run           # Preview what would run
EOF
}

# --- Argument Parsing ---
parse_arguments() {
    while [[ $# -gt 0 ]]; do
        if parse_common_flag "$1"; then
            shift
            continue
        fi
        case "$1" in
            -o|--open) OPEN_REPORTS=1; shift ;;
            --php-binary)
                if [[ -n "${2:-}" ]]; then
                    PHP_BINARY="$2"; shift 2
                else
                    error_log "--php-binary requires a path"
                    exit 1
                fi ;;
            --no-*)
                local mod="${1#--no-}"
                if [[ -n "${MODULE_NAME[$mod]:-}" ]]; then
                    MODULE_ACTIVE[$mod]=0
                else
                    error_log "Unknown module: $mod"
                    exit 1
                fi
                shift ;;
            *)
                error_log "Unknown option: $1"
                usage
                exit 1 ;;
        esac
    done

    for mod in $ALL_MODULES; do
        if [[ "${MODULE_ACTIVE[$mod]}" -eq 1 ]]; then
            ENABLED_MODULES+=("$mod")
        fi
    done
}

# --- Module Functions ---
step_cleanup() {
    run_cmd rm -rf coverage/phpunit coverage/vitest || return 1
    run_cmd mkdir -p coverage/phpunit coverage/vitest || return 1
}

step_phpunit() {
    run_cmd $PHP_BINARY vendor/bin/phpunit \
        --coverage-html coverage/phpunit/html \
        --coverage-text=coverage/phpunit/report.txt || return 1
}

step_vitest() {
    run_cmd npm run test:coverage || return 1
}

# --- Module Runner ---
run_module() {
    local mod="$1"
    local name="${MODULE_NAME[$mod]}"
    local icon="${MODULE_ICON[$mod]}"
    local start=$SECONDS

    echo ""
    info_log "── ${icon} ${COLOR_BOLD}${name}${COLOR_RESET} ──"

    local exit_code=0
    "step_${mod}" || exit_code=$?

    local duration=$(printf '%.1f' $(( SECONDS - start )))

    if [[ $exit_code -eq 0 ]]; then
        RESULT_STATUS[$mod]="success"
        ok_log "${name} (${duration}s)"
    else
        RESULT_STATUS[$mod]="failed"
        error_log "${name} failed (${duration}s)"
    fi
    RESULT_DURATION[$mod]="$duration"
}

# --- Summary ---
show_summary() {
    local total_duration=$(printf '%.1f' $(( SECONDS - TOTAL_START )))
    local success=0 failed=0

    echo ""
    echo ""
    info_log "── ${COLOR_BOLD}Summary${COLOR_RESET} ──"
    echo ""

    for mod in $ENABLED_MODULES; do
        local name="${MODULE_NAME[$mod]}"
        local icon="${MODULE_ICON[$mod]}"
        local mod_status="${RESULT_STATUS[$mod]}"
        local duration="${RESULT_DURATION[$mod]}"
        local symbol="" color=""

        case "$mod_status" in
            success) symbol="✓"; color="$COLOR_GREEN"; success=$((success + 1)) ;;
            failed)  symbol="✗"; color="$COLOR_RED"; failed=$((failed + 1)) ;;
        esac

        printf "  %s %-24s %s%s%s  %ss\n" "$icon" "$name" "$color" "$symbol" "$COLOR_RESET" "$duration"
    done

    echo ""
    printf "  ${COLOR_DIM}Total: ${total_duration}s${COLOR_RESET}  "
    printf "${COLOR_GREEN}✓ ${success}${COLOR_RESET}  "
    printf "${COLOR_RED}✗ ${failed}${COLOR_RESET}\n"
    echo ""

    # Report locations
    if [[ "$QUIET" -eq 0 ]]; then
        info_log "── ${COLOR_BOLD}Reports${COLOR_RESET} ──"
        echo ""
        [[ -f "coverage/phpunit/html/index.html" ]] && \
            printf "  🧪 %-16s %s\n" "PHPUnit HTML:" "coverage/phpunit/html/index.html"
        [[ -f "coverage/phpunit/report.txt" ]] && \
            printf "  🧪 %-16s %s\n" "PHPUnit Text:" "coverage/phpunit/report.txt"
        [[ -f "coverage/vitest/index.html" ]] && \
            printf "  🧪 %-16s %s\n" "Vitest HTML:" "coverage/vitest/index.html"
        echo ""
    fi

    if [[ $failed -eq 0 ]]; then
        ok_log "All coverage complete!"
    else
        error_log "Some coverage runs failed."
        return 1
    fi
}

open_reports() {
    if [[ "$OPEN_REPORTS" -eq 1 && "$DRY_RUN" -eq 0 ]]; then
        info_log "Opening coverage reports..."
        [[ -f "coverage/phpunit/html/index.html" ]] && open coverage/phpunit/html/index.html 2>/dev/null
        [[ -f "coverage/vitest/index.html" ]] && open coverage/vitest/index.html 2>/dev/null
    fi
}

# --- Main ---
main() {
    parse_arguments "$@"

    TOTAL_START=$SECONDS

    if [[ ${#ENABLED_MODULES[@]} -eq 0 ]]; then
        warn_log "No modules selected."
        exit 1
    fi

    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "${COLOR_BOLD}${COLOR_YELLOW}🧪 Coverage${COLOR_RESET} ${COLOR_DIM}PHP-Flasher test coverage...${COLOR_RESET} ${COLOR_YELLOW}[DRY-RUN]${COLOR_RESET}"
    else
        echo "${COLOR_BOLD}${COLOR_CYAN}🧪 Coverage${COLOR_RESET} ${COLOR_DIM}PHP-Flasher test coverage...${COLOR_RESET}"
    fi

    for mod in $ENABLED_MODULES; do
        run_module "$mod"
    done

    show_summary
    open_reports
}

main "$@"
