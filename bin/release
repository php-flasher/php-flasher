#!/usr/bin/env zsh
# -----------------------------------------------------------------------------
# release v1.0.0
#
# Description:
#   Create release tags across all PHP-Flasher repositories.
#   Validates environment, clones each repo, creates and pushes tags.
#
# Usage:
#   release <version> [options]
#
# Examples:
#   release 2.6.0                # Tag all repos with v2.6.0
#   release --dry-run 2.6.0      # Preview what would be tagged
#   release -q 2.6.0             # Quiet mode
# -----------------------------------------------------------------------------
VERSION="1.0.0"
source "${0:A:h}/_lib.zsh"

RELEASE_BRANCH="2.x"

# --- Repository Configuration ---
ALL_REPOS=(
    flasher
    flasher-laravel
    flasher-symfony
    flasher-noty
    flasher-noty-laravel
    flasher-noty-symfony
    flasher-notyf
    flasher-notyf-laravel
    flasher-notyf-symfony
    flasher-sweetalert
    flasher-sweetalert-laravel
    flasher-sweetalert-symfony
    flasher-toastr
    flasher-toastr-laravel
    flasher-toastr-symfony
)

# Results tracking
typeset -A RESULT_STATUS RESULT_DURATION
TOTAL_START=0

# --- Usage ---
usage() {
    cat <<EOF
${COLOR_BOLD}${COLOR_GREEN}Usage:${COLOR_RESET} ${SCRIPT_NAME} [options] <version>

${COLOR_BOLD}${COLOR_GREEN}Description:${COLOR_RESET}
  Create release tags across all PHP-Flasher repositories.

${COLOR_BOLD}${COLOR_YELLOW}Options:${COLOR_RESET}
  ${COLOR_CYAN}-n, --dry-run${COLOR_RESET}       Show what would be tagged without executing
  ${COLOR_CYAN}-q, --quiet${COLOR_RESET}         Suppress command output
  ${COLOR_CYAN}-d, --debug${COLOR_RESET}         Enable debug logging
  ${COLOR_CYAN}-v, --version${COLOR_RESET}       Display version
  ${COLOR_CYAN}-h, --help${COLOR_RESET}          Display this help message

${COLOR_BOLD}${COLOR_BLUE}Examples:${COLOR_RESET}
  ${SCRIPT_NAME} 2.6.0                # Tag all repos with v2.6.0
  ${SCRIPT_NAME} --dry-run 2.6.0      # Preview what would be tagged
EOF
}

# --- Argument Parsing ---
TAG_VERSION=""

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        if parse_common_flag "$1"; then
            shift
            continue
        fi
        case "$1" in
            -*)
                error_log "Unknown option: $1"
                usage
                exit 1 ;;
            *)
                TAG_VERSION="$1"
                shift ;;
        esac
    done

    if [[ -z "$TAG_VERSION" ]]; then
        error_log "Version tag is required"
        usage
        exit 1
    fi

    [[ $TAG_VERSION != v* ]] && TAG_VERSION="v$TAG_VERSION"
}

# --- Validation ---
validate_version() {
    if [[ ! $TAG_VERSION =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        error_log "Invalid version format: $TAG_VERSION"
        info_log "Version must be X.Y.Z or vX.Y.Z (e.g., 2.6.0 or v2.6.0)"
        exit 1
    fi
}

validate_environment() {
    info_log "── 🔐 ${COLOR_BOLD}Environment Validation${COLOR_RESET} ──"

    local has_error=0

    # Check branch
    local current_branch=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$RELEASE_BRANCH" != "$current_branch" ]]; then
        error_log "Wrong branch: $current_branch (expected: $RELEASE_BRANCH)"
        has_error=1
    else
        ok_log "On correct branch: $current_branch"
    fi

    # Check working directory
    if [[ -n "$(git status --porcelain)" ]]; then
        error_log "Working directory is not clean"
        has_error=1
    else
        ok_log "Working directory is clean"
    fi

    # Check sync with remote
    git fetch origin > /dev/null 2>&1
    local local_sha=$(git rev-parse HEAD)
    local remote_sha=$(git rev-parse "origin/$RELEASE_BRANCH")

    if [[ "$local_sha" != "$remote_sha" ]]; then
        error_log "Branch is not in sync with origin/$RELEASE_BRANCH"
        has_error=1
    else
        ok_log "Branch is in sync with remote"
    fi

    if [[ $has_error -eq 1 ]]; then
        echo ""
        error_log "Environment validation failed"
        exit 1
    fi

    echo ""
    ok_log "Environment validated"
}

# --- Release Function ---
check_tag_exists() {
    local repo=$1 tag=$2
    git ls-remote --tags "git@github.com:php-flasher/$repo.git" | grep -q "refs/tags/$tag$"
}

release_repository() {
    local repo=$1 version=$2
    local tmp_dir="/tmp/php-flasher"
    local remote_url="git@github.com:php-flasher/$repo.git"

    debug_log "Releasing $repo with tag $version"

    if check_tag_exists "$repo" "$version"; then
        warn_log "Tag $version already exists, skipping"
        return 2
    fi

    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf "  ${COLOR_YELLOW}[DRY-RUN]${COLOR_RESET} ${COLOR_DIM}git clone $remote_url${COLOR_RESET}\n"
        printf "  ${COLOR_YELLOW}[DRY-RUN]${COLOR_RESET} ${COLOR_DIM}git tag $version && git push origin --tags${COLOR_RESET}\n"
        return 0
    fi

    rm -rf "$tmp_dir"
    mkdir -p "$tmp_dir"

    if ! git clone "$remote_url" "$tmp_dir" >/dev/null 2>&1; then
        error_log "Failed to clone $repo"
        return 1
    fi

    (
        cd "$tmp_dir"
        git checkout "$RELEASE_BRANCH" >/dev/null 2>&1
        git tag "$version"

        if ! git push origin --tags --force >/dev/null 2>&1; then
            error_log "Failed to push tag to $repo"
            return 1
        fi
    ) || return 1

    ok_log "Tagged ${COLOR_BOLD}${repo}${COLOR_RESET} with ${COLOR_YELLOW}${version}${COLOR_RESET}"
}

# --- Main ---
main() {
    parse_arguments "$@"
    validate_version

    TOTAL_START=$SECONDS

    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "${COLOR_BOLD}${COLOR_YELLOW}🏷️  Release${COLOR_RESET} ${COLOR_DIM}PHP-Flasher tags...${COLOR_RESET} ${COLOR_YELLOW}[DRY-RUN]${COLOR_RESET}"
    else
        echo "${COLOR_BOLD}${COLOR_CYAN}🏷️  Release${COLOR_RESET} ${COLOR_DIM}PHP-Flasher tags...${COLOR_RESET}"
    fi
    info_log "Version: ${COLOR_BOLD}${TAG_VERSION}${COLOR_RESET}"

    echo ""
    validate_environment

    local success=0 skipped=0 failed=0
    local failed_repos=()
    local total=${#ALL_REPOS[@]}
    local current=0

    for repo in $ALL_REPOS; do
        current=$((current + 1))
        local start=$SECONDS

        echo ""
        info_log "── 🏷️  ${COLOR_BOLD}${repo}${COLOR_RESET} ${COLOR_DIM}($current/$total)${COLOR_RESET} ──"

        local exit_code=0
        release_repository "$repo" "$TAG_VERSION" || exit_code=$?

        local duration=$(printf '%.1f' $(( SECONDS - start )))
        RESULT_DURATION[$repo]="$duration"

        case $exit_code in
            0) RESULT_STATUS[$repo]="success"; success=$((success + 1)) ;;
            1) RESULT_STATUS[$repo]="failed"; failed=$((failed + 1)); failed_repos+=("$repo") ;;
            2) RESULT_STATUS[$repo]="skipped"; skipped=$((skipped + 1)) ;;
        esac
    done

    # Summary
    local total_duration=$(printf '%.1f' $(( SECONDS - TOTAL_START )))

    echo ""
    echo ""
    info_log "── ${COLOR_BOLD}Summary${COLOR_RESET} ──"
    echo ""
    printf "  ${COLOR_DIM}Tag:${COLOR_RESET} ${COLOR_BOLD}${TAG_VERSION}${COLOR_RESET}\n"
    echo ""
    printf "  ${COLOR_GREEN}✓ ${success}${COLOR_RESET} tagged  "
    printf "${COLOR_YELLOW}⚠ ${skipped}${COLOR_RESET} skipped  "
    printf "${COLOR_RED}✗ ${failed}${COLOR_RESET} failed  "
    printf "${COLOR_DIM}(${total} repos, ${total_duration}s)${COLOR_RESET}\n"

    if [[ ${#failed_repos[@]} -gt 0 ]]; then
        echo ""
        error_log "Failed repos:"
        for repo in "${failed_repos[@]}"; do
            printf "  ${COLOR_RED}✗${COLOR_RESET} %s\n" "$repo"
        done
    fi

    echo ""
    if [[ $failed -eq 0 ]]; then
        ok_log "Release complete!"
    else
        error_log "Release had failures."
        exit 1
    fi
}

main "$@"
