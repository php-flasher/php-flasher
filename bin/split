#!/usr/bin/env zsh
# -----------------------------------------------------------------------------
# split v1.0.0
#
# Description:
#   Split PHP-Flasher monorepo into individual read-only repositories.
#   Uses splitsh-lite to extract subtrees and pushes to GitHub remotes.
#
# Usage:
#   split [options]
#
# Examples:
#   split                        # Split all packages
#   split --dry-run              # Preview what would be split
#   split -q                     # Quiet mode
# -----------------------------------------------------------------------------
VERSION="1.0.0"
source "${0:A:h}/_lib.zsh"

# --- Repository Configuration ---
# Ordered list for deterministic iteration
ALL_SPLITS=(
    src/Prime
    src/Laravel
    src/Symfony
    src/Toastr/Prime
    src/Toastr/Laravel
    src/Toastr/Symfony
    src/Notyf/Prime
    src/Notyf/Laravel
    src/Notyf/Symfony
    src/SweetAlert/Prime
    src/SweetAlert/Laravel
    src/SweetAlert/Symfony
    src/Noty/Prime
    src/Noty/Laravel
    src/Noty/Symfony
)

typeset -A SPLIT_REMOTE
SPLIT_REMOTE=(
    "src/Prime"                "flasher"
    "src/Laravel"              "flasher-laravel"
    "src/Symfony"              "flasher-symfony"
    "src/Toastr/Prime"         "flasher-toastr"
    "src/Toastr/Laravel"       "flasher-toastr-laravel"
    "src/Toastr/Symfony"       "flasher-toastr-symfony"
    "src/Notyf/Prime"          "flasher-notyf"
    "src/Notyf/Laravel"        "flasher-notyf-laravel"
    "src/Notyf/Symfony"        "flasher-notyf-symfony"
    "src/SweetAlert/Prime"     "flasher-sweetalert"
    "src/SweetAlert/Laravel"   "flasher-sweetalert-laravel"
    "src/SweetAlert/Symfony"   "flasher-sweetalert-symfony"
    "src/Noty/Prime"           "flasher-noty"
    "src/Noty/Laravel"         "flasher-noty-laravel"
    "src/Noty/Symfony"         "flasher-noty-symfony"
)

# Results tracking
typeset -A RESULT_STATUS RESULT_DURATION
TOTAL_START=0

# --- Usage ---
usage() {
    cat <<EOF
${COLOR_BOLD}${COLOR_GREEN}Usage:${COLOR_RESET} ${SCRIPT_NAME} [options]

${COLOR_BOLD}${COLOR_GREEN}Description:${COLOR_RESET}
  Split PHP-Flasher monorepo into individual read-only repositories.

${COLOR_BOLD}${COLOR_YELLOW}Options:${COLOR_RESET}
  ${COLOR_CYAN}-n, --dry-run${COLOR_RESET}       Show what would be split without executing
  ${COLOR_CYAN}-q, --quiet${COLOR_RESET}         Suppress command output
  ${COLOR_CYAN}-d, --debug${COLOR_RESET}         Enable debug logging
  ${COLOR_CYAN}-v, --version${COLOR_RESET}       Display version
  ${COLOR_CYAN}-h, --help${COLOR_RESET}          Display this help message

${COLOR_BOLD}${COLOR_BLUE}Examples:${COLOR_RESET}
  ${SCRIPT_NAME}                        # Split all packages
  ${SCRIPT_NAME} --dry-run              # Preview what would be split
EOF
}

# --- Argument Parsing ---
while [[ $# -gt 0 ]]; do
    if parse_common_flag "$1"; then
        shift
    else
        error_log "Unknown option: $1"
        usage
        exit 1
    fi
done

# --- Split Function ---
process_split() {
    local prefix="$1"
    local remote="${SPLIT_REMOTE[$prefix]}"
    local branch=$(git rev-parse --abbrev-ref HEAD)

    debug_log "Splitting $prefix -> $remote (branch: $branch)"

    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf "  ${COLOR_YELLOW}[DRY-RUN]${COLOR_RESET} ${COLOR_DIM}splitsh-lite --prefix=$prefix${COLOR_RESET}\n"
        printf "  ${COLOR_YELLOW}[DRY-RUN]${COLOR_RESET} ${COLOR_DIM}git push $remote <sha>:refs/heads/$branch -f${COLOR_RESET}\n"
        return 0
    fi

    local sha1
    if ! sha1=$(./bin/splitsh-lite --prefix="$prefix" 2>/dev/null); then
        error_log "Split failed for $prefix"
        return 1
    fi

    debug_log "Split SHA: $sha1"

    if ! git push "$remote" "$sha1:refs/heads/$branch" -f > /dev/null 2>&1; then
        error_log "Failed to push to $remote"
        return 1
    fi

    ok_log "Pushed to ${COLOR_BOLD}$remote${COLOR_RESET} (${COLOR_DIM}${sha1:0:8}${COLOR_RESET})"
}

# --- Main ---
main() {
    TOTAL_START=$SECONDS

    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "${COLOR_BOLD}${COLOR_YELLOW}✂️  Split${COLOR_RESET} ${COLOR_DIM}PHP-Flasher monorepo...${COLOR_RESET} ${COLOR_YELLOW}[DRY-RUN]${COLOR_RESET}"
    else
        echo "${COLOR_BOLD}${COLOR_CYAN}✂️  Split${COLOR_RESET} ${COLOR_DIM}PHP-Flasher monorepo...${COLOR_RESET}"
    fi

    # Fetch latest
    echo ""
    info_log "── 🔄 ${COLOR_BOLD}Fetch Latest${COLOR_RESET} ──"
    run_cmd git fetch origin "$(git rev-parse --abbrev-ref HEAD)" || true

    local success=0 failed=0
    local total=${#ALL_SPLITS[@]}
    local current=0

    for prefix in $ALL_SPLITS; do
        current=$((current + 1))
        local remote="${SPLIT_REMOTE[$prefix]}"
        local start=$SECONDS

        echo ""
        info_log "── ✂️  ${COLOR_BOLD}${remote}${COLOR_RESET} ${COLOR_DIM}($current/$total)${COLOR_RESET} ──"

        local exit_code=0
        process_split "$prefix" || exit_code=$?

        local duration=$(printf '%.1f' $(( SECONDS - start )))

        if [[ $exit_code -eq 0 ]]; then
            RESULT_STATUS[$prefix]="success"
            success=$((success + 1))
        else
            RESULT_STATUS[$prefix]="failed"
            failed=$((failed + 1))
        fi
        RESULT_DURATION[$prefix]="$duration"
    done

    # Summary
    local total_duration=$(printf '%.1f' $(( SECONDS - TOTAL_START )))

    echo ""
    echo ""
    info_log "── ${COLOR_BOLD}Summary${COLOR_RESET} ──"
    echo ""
    printf "  ${COLOR_GREEN}✓ ${success}${COLOR_RESET} succeeded  "
    printf "${COLOR_RED}✗ ${failed}${COLOR_RESET} failed  "
    printf "${COLOR_DIM}(${total} total, ${total_duration}s)${COLOR_RESET}\n"

    # List failures
    if [[ $failed -gt 0 ]]; then
        echo ""
        error_log "Failed splits:"
        for prefix in $ALL_SPLITS; do
            if [[ "${RESULT_STATUS[$prefix]}" == "failed" ]]; then
                printf "  ${COLOR_RED}✗${COLOR_RESET} %s → %s\n" "$prefix" "${SPLIT_REMOTE[$prefix]}"
            fi
        done
    fi

    echo ""
    if [[ $failed -eq 0 ]]; then
        ok_log "All splits complete!"
    else
        error_log "Some splits failed."
        return 1
    fi
}

main
