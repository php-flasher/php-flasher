#!/usr/bin/env zsh
# -----------------------------------------------------------------------------
# docs v1.0.0
#
# Description:
#   Build PHP-Flasher documentation site.
#
# Usage:
#   docs [options]
#
# Examples:
#   docs                         # Install deps and build
#   docs --dry-run               # Preview what would run
#   docs -q                      # Quiet mode
# -----------------------------------------------------------------------------
VERSION="1.0.0"
source "${0:A:h}/_lib.zsh"

# --- Usage ---
usage() {
    cat <<EOF
${COLOR_BOLD}${COLOR_GREEN}Usage:${COLOR_RESET} ${SCRIPT_NAME} [options]

${COLOR_BOLD}${COLOR_GREEN}Description:${COLOR_RESET}
  Build PHP-Flasher documentation site.

${COLOR_BOLD}${COLOR_YELLOW}Options:${COLOR_RESET}
  ${COLOR_CYAN}-n, --dry-run${COLOR_RESET}     Show what would run without executing
  ${COLOR_CYAN}-q, --quiet${COLOR_RESET}       Suppress output
  ${COLOR_CYAN}-d, --debug${COLOR_RESET}       Enable debug logging
  ${COLOR_CYAN}-v, --version${COLOR_RESET}     Display version
  ${COLOR_CYAN}-h, --help${COLOR_RESET}        Display this help message
EOF
}

# --- Argument Parsing ---
while [[ $# -gt 0 ]]; do
    if parse_common_flag "$1"; then
        shift
    else
        error_log "Unknown option: $1"
        usage
        exit 1
    fi
done

# --- Steps ---
typeset -A RESULT_STATUS RESULT_DURATION

ALL_STEPS=(install build)
typeset -A STEP_NAME STEP_ICON
STEP_NAME=(install "Install Dependencies" build "Build Documentation")
STEP_ICON=(install "📦" build "🏗️")

step_install() {
    run_cmd npm install --force || return 1
}

step_build() {
    run_cmd npm run build || return 1
}

run_step() {
    local step="$1"
    local name="${STEP_NAME[$step]}"
    local icon="${STEP_ICON[$step]}"
    local start=$SECONDS

    echo ""
    info_log "── ${icon} ${COLOR_BOLD}${name}${COLOR_RESET} ──"

    local exit_code=0
    "step_${step}" || exit_code=$?

    local duration=$(printf '%.1f' $(( SECONDS - start )))

    if [[ $exit_code -eq 0 ]]; then
        RESULT_STATUS[$step]="success"
        ok_log "${name} (${duration}s)"
    else
        RESULT_STATUS[$step]="failed"
        error_log "${name} failed (${duration}s)"
    fi
    RESULT_DURATION[$step]="$duration"
}

show_summary() {
    local total_duration=$(printf '%.1f' $(( SECONDS - TOTAL_START )))
    local success=0 failed=0

    echo ""
    echo ""
    info_log "── ${COLOR_BOLD}Summary${COLOR_RESET} ──"
    echo ""

    for step in $ALL_STEPS; do
        local name="${STEP_NAME[$step]}"
        local icon="${STEP_ICON[$step]}"
        local step_status="${RESULT_STATUS[$step]}"
        local duration="${RESULT_DURATION[$step]}"
        local symbol="" color=""

        case "$step_status" in
            success) symbol="✓"; color="$COLOR_GREEN"; success=$((success + 1)) ;;
            failed)  symbol="✗"; color="$COLOR_RED"; failed=$((failed + 1)) ;;
        esac

        printf "  %s %-24s %s%s%s  %ss\n" "$icon" "$name" "$color" "$symbol" "$COLOR_RESET" "$duration"
    done

    echo ""
    printf "  ${COLOR_DIM}Total: ${total_duration}s${COLOR_RESET}  "
    printf "${COLOR_GREEN}✓ ${success}${COLOR_RESET}  "
    printf "${COLOR_RED}✗ ${failed}${COLOR_RESET}\n"
    echo ""

    [[ $failed -eq 0 ]]
}

# --- Main ---
main() {
    if [[ ! -d "docs/" ]]; then
        error_log "Documentation directory 'docs/' not found"
        exit 1
    fi

    cd docs/

    echo "${COLOR_BOLD}${COLOR_CYAN}📚 Build${COLOR_RESET} ${COLOR_DIM}PHP-Flasher documentation...${COLOR_RESET}"

    TOTAL_START=$SECONDS

    for step in $ALL_STEPS; do
        run_step "$step"
    done

    show_summary
}

main
