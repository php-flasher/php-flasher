#!/usr/bin/env zsh
# -----------------------------------------------------------------------------
# npm v1.0.0
#
# Description:
#   Publish PHP-Flasher packages to the npm registry.
#   Checks authentication, skips already-published versions.
#
# Usage:
#   npm <version> [options]
#
# Examples:
#   npm 2.6.0                    # Publish all packages at 2.6.0
#   npm --dry-run 2.6.0          # Preview what would be published
#   npm -q 2.6.0                 # Quiet mode
# -----------------------------------------------------------------------------
VERSION="1.0.0"
SCRIPT_NAME="npm-publish"
source "${0:A:h}/_lib.zsh"

# --- Package Configuration ---
ALL_PACKAGES=(
    "src/Prime/Resources:@flasher/flasher"
    "src/Noty/Prime/Resources:@flasher/flasher-noty"
    "src/Notyf/Prime/Resources:@flasher/flasher-notyf"
    "src/SweetAlert/Prime/Resources:@flasher/flasher-sweetalert"
    "src/Toastr/Prime/Resources:@flasher/flasher-toastr"
)

# Results tracking
typeset -A RESULT_STATUS RESULT_DURATION
TOTAL_START=0

# --- Usage ---
usage() {
    cat <<EOF
${COLOR_BOLD}${COLOR_GREEN}Usage:${COLOR_RESET} ${SCRIPT_NAME} [options] <version>

${COLOR_BOLD}${COLOR_GREEN}Description:${COLOR_RESET}
  Publish PHP-Flasher packages to the npm registry.

${COLOR_BOLD}${COLOR_YELLOW}Packages:${COLOR_RESET}
  ${COLOR_CYAN}@flasher/flasher${COLOR_RESET}              Core package
  ${COLOR_CYAN}@flasher/flasher-noty${COLOR_RESET}         Noty adapter
  ${COLOR_CYAN}@flasher/flasher-notyf${COLOR_RESET}        Notyf adapter
  ${COLOR_CYAN}@flasher/flasher-sweetalert${COLOR_RESET}   SweetAlert adapter
  ${COLOR_CYAN}@flasher/flasher-toastr${COLOR_RESET}       Toastr adapter

${COLOR_BOLD}${COLOR_YELLOW}Options:${COLOR_RESET}
  ${COLOR_CYAN}-n, --dry-run${COLOR_RESET}       Show what would be published without executing
  ${COLOR_CYAN}-q, --quiet${COLOR_RESET}         Suppress command output
  ${COLOR_CYAN}-d, --debug${COLOR_RESET}         Enable debug logging
  ${COLOR_CYAN}-v, --version${COLOR_RESET}       Display version
  ${COLOR_CYAN}-h, --help${COLOR_RESET}          Display this help message

${COLOR_BOLD}${COLOR_BLUE}Examples:${COLOR_RESET}
  ${SCRIPT_NAME} 2.6.0                    # Publish all packages
  ${SCRIPT_NAME} --dry-run 2.6.0          # Preview what would be published
EOF
}

# --- Argument Parsing ---
PKG_VERSION=""

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        if parse_common_flag "$1"; then
            shift
            continue
        fi
        case "$1" in
            -*)
                error_log "Unknown option: $1"
                usage
                exit 1 ;;
            *)
                PKG_VERSION="$1"
                shift ;;
        esac
    done

    if [[ -z "$PKG_VERSION" ]]; then
        error_log "Version number is required"
        usage
        exit 1
    fi

    PKG_VERSION="${PKG_VERSION#v}"
}

# --- Helpers ---
check_version_exists() {
    command npm view "${1}@${2}" version >/dev/null 2>&1
}

validate_npm_auth() {
    info_log "── 🔐 ${COLOR_BOLD}NPM Authentication${COLOR_RESET} ──"

    if ! command -v npm >/dev/null 2>&1; then
        error_log "npm is not installed"
        return 1
    fi

    if ! command npm whoami >/dev/null 2>&1; then
        error_log "Not logged in to npm. Run 'npm login' first."
        return 1
    fi

    ok_log "Authenticated as $(command npm whoami)"
}

# --- Package Processor ---
process_package() {
    local path_and_name="$1"
    local version="$2"
    local path="${path_and_name%:*}"
    local package="${path_and_name#*:}"

    if [[ ! -d "$path" ]]; then
        warn_log "Directory $path does not exist, skipping"
        return 2
    fi

    if check_version_exists "$package" "$version"; then
        warn_log "Version ${version} already exists for ${package}, skipping"
        return 2
    fi

    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf "  ${COLOR_YELLOW}[DRY-RUN]${COLOR_RESET} ${COLOR_DIM}npm publish ${package}@${version} --access public${COLOR_RESET}\n"
        return 0
    fi

    (cd "$path" && command npm install --silent) || {
        error_log "Failed to install dependencies for $package"
        return 1
    }

    (cd "$path" && command npm version "$version" --no-git-tag-version --allow-same-version >/dev/null 2>&1) || true

    if (cd "$path" && command npm publish --access public); then
        ok_log "Published ${COLOR_BOLD}${package}@${version}${COLOR_RESET}"
        return 0
    else
        error_log "Failed to publish $package"
        return 1
    fi
}

# --- Main ---
main() {
    parse_arguments "$@"

    TOTAL_START=$SECONDS

    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "${COLOR_BOLD}${COLOR_YELLOW}📦 Publish${COLOR_RESET} ${COLOR_DIM}PHP-Flasher NPM packages...${COLOR_RESET} ${COLOR_YELLOW}[DRY-RUN]${COLOR_RESET}"
    else
        echo "${COLOR_BOLD}${COLOR_CYAN}📦 Publish${COLOR_RESET} ${COLOR_DIM}PHP-Flasher NPM packages...${COLOR_RESET}"
    fi
    info_log "Version: ${COLOR_BOLD}${PKG_VERSION}${COLOR_RESET}"

    echo ""
    validate_npm_auth || exit 1

    local success=0 skipped=0 failed=0
    local failed_packages=()
    local total=${#ALL_PACKAGES[@]}
    local current=0

    for pkg_info in $ALL_PACKAGES; do
        current=$((current + 1))
        local package="${pkg_info#*:}"
        local start=$SECONDS

        echo ""
        info_log "── 📦 ${COLOR_BOLD}${package}${COLOR_RESET} ${COLOR_DIM}($current/$total)${COLOR_RESET} ──"

        local exit_code=0
        process_package "$pkg_info" "$PKG_VERSION" || exit_code=$?

        local duration=$(printf '%.1f' $(( SECONDS - start )))
        RESULT_DURATION[$package]="$duration"

        case $exit_code in
            0) RESULT_STATUS[$package]="success"; success=$((success + 1)) ;;
            1) RESULT_STATUS[$package]="failed"; failed=$((failed + 1)); failed_packages+=("$package") ;;
            2) RESULT_STATUS[$package]="skipped"; skipped=$((skipped + 1)) ;;
        esac
    done

    # Summary
    local total_duration=$(printf '%.1f' $(( SECONDS - TOTAL_START )))

    echo ""
    echo ""
    info_log "── ${COLOR_BOLD}Summary${COLOR_RESET} ──"
    echo ""
    printf "  ${COLOR_DIM}Version:${COLOR_RESET} ${COLOR_BOLD}v${PKG_VERSION}${COLOR_RESET}\n"
    echo ""
    printf "  ${COLOR_GREEN}✓ ${success}${COLOR_RESET} published  "
    printf "${COLOR_YELLOW}⚠ ${skipped}${COLOR_RESET} skipped  "
    printf "${COLOR_RED}✗ ${failed}${COLOR_RESET} failed  "
    printf "${COLOR_DIM}(${total_duration}s)${COLOR_RESET}\n"

    if [[ ${#failed_packages[@]} -gt 0 ]]; then
        echo ""
        error_log "Failed packages:"
        for pkg in "${failed_packages[@]}"; do
            printf "  ${COLOR_RED}✗${COLOR_RESET} %s\n" "$pkg"
        done
    fi

    echo ""
    if [[ $success -eq 0 && $skipped -gt 0 && $failed -eq 0 ]]; then
        ok_log "All packages already up to date!"
    elif [[ $failed -eq 0 ]]; then
        ok_log "NPM publish complete!"
    else
        error_log "NPM publish had failures."
        exit 1
    fi
}

main "$@"
